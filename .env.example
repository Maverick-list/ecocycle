# ==============================================================================
# ECOCYCLE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your actual cloud credentials.
# IMPORTANT: Never commit .env or expose your private keys / service accounts!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE FIREBASE CONFIGURATION (PRIMARY CLOUD BACKEND)
# Obtain these from: Firebase Console > Project Settings > General > Your Apps (Web App)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyA_ExampleApiKeyForEcocycleProduction
VITE_FIREBASE_AUTH_DOMAIN=ecocycle-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ecocycle-prod
VITE_FIREBASE_STORAGE_BUCKET=ecocycle-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=109283746501
VITE_FIREBASE_APP_ID=1:109283746501:web:abcdef1234567890fedcba
VITE_FIREBASE_MEASUREMENT_ID=G-ECOCYCLE99

# Optional: Firebase App Check reCAPTCHA v3 or Enterprise site key
# VITE_FIREBASE_APP_CHECK_KEY=6Ldxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Local Firebase Emulator suite (set to 'true' for offline test suites)
# VITE_FIREBASE_USE_EMULATOR=false

# ------------------------------------------------------------------------------
# 2. SITE & CANONICAL DOMAIN CONFIGURATION
# Used for SEO canonical tags, Open Graph URLs, and OAuth callback redirects
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://ecocycle.id

# ------------------------------------------------------------------------------
# 3. SUPABASE CONFIGURATION (FALLBACK / MIGRATION BACKEND)
# Kept for backward compatibility and verified migration transition
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI CONFIGURATION (ECOCYCLE AI CHATBOT & VOICE ASSISTANT)
# Obtain from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=AIzaSy_YourGoogleGeminiApiKeyHere
